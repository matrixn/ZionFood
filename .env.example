APP_NAME=ZionFood
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=ro
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=13316
DB_DATABASE=zionfood
DB_USERNAME=zionfood
DB_PASSWORD=
DB_ROOT_PASSWORD=
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=16379
REDIS_DB=0
REDIS_CACHE_DB=1
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=zionfood-local
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_ALLOWED_ORIGINS=localhost,127.0.0.1,app.zionfood.ro
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
MAIL_MAILER=log
# Production: MAIL_MAILER=resend and a sending API key for a verified domain.
RESEND_API_KEY=
ADMIN_EMAIL=dummy@dummy.com
MAIL_ERROR_ALERTS=true
MAIL_RATE_LIMIT_STORE=redis
MAIL_QUEUE_CONNECTION=redis
MAIL_FROM_ADDRESS=hello@zionfood.ro
MAIL_FROM_NAME="${APP_NAME}"
ZF_APP_HOSTS=localhost,127.0.0.1,app.zionfood.ro
ZF_API_HOSTS=localhost,127.0.0.1,api.zionfood.ro
ZF_STOREFRONT_DOMAIN=zionfood.ro
ZF_CHECKOUT_IP_LIMIT=10
ZF_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
ZF_MAP_ATTRIBUTION="© <a href='https://www.openstreetmap.org/copyright'>OpenStreetMap contributors</a>"

ZF_GEOCODER_URL=https://photon.komoot.io/api/
