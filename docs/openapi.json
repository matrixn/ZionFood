{
  "openapi": "3.0.3",
  "info": {
    "title": "ZionFood API",
    "version": "0.0.1",
    "description": "API v1. Token abilities supplement tenant and location authorization. Browser session mutations require CSRF tokens. Money is integer minor units."
  },
  "servers": [
    {
      "url": "https://api.zionfood.ro/api/v1"
    },
    {
      "url": "http://localhost:8000/api/v1"
    }
  ],
  "paths": {
    "/public/locations/{location}/menu": {
      "get": {
        "summary": "Public location menu",
        "parameters": [
          {
            "name": "location",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MenuResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not found"
          },
          "422": {
            "description": "Validation failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/public/locations/{location}/checkout": {
      "post": {
        "summary": "Place an order or safely replay an identical checkout",
        "parameters": [
          {
            "name": "location",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 16,
              "maxLength": 100,
              "pattern": "^[A-Za-z0-9_-]+$"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckoutResult"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not found"
          },
          "422": {
            "description": "Validation failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "200": {
            "description": "Existing idempotent result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckoutResult"
                }
              }
            }
          },
          "409": {
            "description": "Key used with different payload"
          },
          "429": {
            "description": "Checkout rate limit"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Checkout"
              }
            }
          }
        }
      }
    },
    "/public/orders/{order}": {
      "get": {
        "summary": "Token-protected tracking without customer contact information",
        "parameters": [
          {
            "name": "order",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Tracking"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not found"
          },
          "422": {
            "description": "Validation failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "trackingToken": []
          }
        ]
      }
    },
    "/locations/{location}/orders": {
      "get": {
        "summary": "Authorized orders, requires orders:read",
        "parameters": [
          {
            "name": "location",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "active",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Order"
                      }
                    },
                    "links": {
                      "type": "object"
                    },
                    "meta": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not found"
          },
          "422": {
            "description": "Validation failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "sanctum": []
          },
          {
            "session": []
          }
        ]
      }
    },
    "/orders/{order}/status": {
      "patch": {
        "summary": "Transition an order, requires orders:manage and expected version",
        "parameters": [
          {
            "name": "order",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Order"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not found"
          },
          "422": {
            "description": "Validation failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Stale order version"
          }
        },
        "security": [
          {
            "sanctum": []
          },
          {
            "session": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Transition"
              }
            }
          }
        }
      }
    },
    "/locations/{location}/menu": {
      "get": {
        "summary": "Tenant menu, requires menu:read",
        "parameters": [
          {
            "name": "location",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "menus": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not found"
          },
          "422": {
            "description": "Validation failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "sanctum": []
          },
          {
            "session": []
          }
        ]
      }
    },
    "/locations/{location}/items": {
      "post": {
        "summary": "Create product, requires menu:write and manager/owner access",
        "parameters": [
          {
            "name": "location",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not found"
          },
          "422": {
            "description": "Validation failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "sanctum": []
          },
          {
            "session": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MenuItemInput"
              }
            }
          }
        }
      }
    },
    "/items/{item}": {
      "put": {
        "summary": "Update product, requires menu:write and manager/owner access",
        "parameters": [
          {
            "name": "item",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not found"
          },
          "422": {
            "description": "Validation failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "sanctum": []
          },
          {
            "session": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MenuItemInput"
              }
            }
          }
        }
      }
    },
    "/locations/{location}/integration-tokens": {
      "get": {
        "summary": "List issuing user token metadata, browser session only",
        "parameters": [
          {
            "name": "location",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "tokens": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not found"
          },
          "422": {
            "description": "Validation failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ]
      },
      "post": {
        "summary": "Issue a token once, browser session only; expires in 90 days",
        "parameters": [
          {
            "name": "location",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": {
                      "type": "string"
                    },
                    "expires_at": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not found"
          },
          "422": {
            "description": "Validation failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TokenInput"
              }
            }
          }
        }
      }
    },
    "/locations/{location}/integration-tokens/{token}": {
      "delete": {
        "summary": "Revoke issuing user organization token, browser session only",
        "parameters": [
          {
            "name": "location",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "token",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Success"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not found"
          },
          "422": {
            "description": "Validation failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "sanctum": {
        "type": "http",
        "scheme": "bearer",
        "description": "Sanctum personal access token"
      },
      "trackingToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "64-character customer order tracking token"
      },
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "zionfood_session",
        "description": "Verified browser session; mutations additionally require CSRF header"
      }
    },
    "schemas": {
      "CheckoutItem": {
        "type": "object",
        "required": [
          "product_id",
          "quantity"
        ],
        "properties": {
          "product_id": {
            "type": "string",
            "description": "Public product ULID"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          },
          "variant_id": {
            "type": "integer",
            "nullable": true
          },
          "modifier_ids": {
            "type": "array",
            "maxItems": 30,
            "items": {
              "type": "integer"
            }
          }
        }
      },
      "Checkout": {
        "type": "object",
        "required": [
          "customer_name",
          "customer_phone",
          "fulfillment",
          "items"
        ],
        "properties": {
          "customer_name": {
            "type": "string",
            "maxLength": 150
          },
          "customer_phone": {
            "type": "string",
            "maxLength": 30
          },
          "fulfillment": {
            "type": "string",
            "enum": [
              "pickup",
              "delivery"
            ]
          },
          "delivery_address": {
            "type": "string",
            "maxLength": 500,
            "description": "Required for delivery"
          },
          "postal_code": {
            "type": "string",
            "maxLength": 20,
            "description": "Required for delivery"
          },
          "delivery_zone_id": {
            "type": "integer",
            "description": "Required for delivery"
          },
          "notes": {
            "type": "string",
            "maxLength": 1000
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": {
              "$ref": "#/components/schemas/CheckoutItem"
            }
          }
        }
      },
      "CheckoutResult": {
        "type": "object",
        "required": [
          "order_id",
          "tracking_token",
          "replayed"
        ],
        "properties": {
          "order_id": {
            "type": "string"
          },
          "tracking_token": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64
          },
          "replayed": {
            "type": "boolean"
          }
        }
      },
      "Transition": {
        "type": "object",
        "required": [
          "status",
          "version"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "accepted",
              "preparing",
              "ready",
              "out_for_delivery",
              "completed",
              "rejected",
              "cancelled"
            ]
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "reason": {
            "type": "string",
            "nullable": true,
            "maxLength": 500,
            "description": "Required for rejection"
          }
        }
      },
      "MenuItemInput": {
        "type": "object",
        "required": [
          "category_id",
          "name",
          "price",
          "is_available"
        ],
        "properties": {
          "category_id": {
            "type": "integer"
          },
          "name": {
            "type": "string",
            "maxLength": 150
          },
          "description": {
            "type": "string",
            "nullable": true,
            "maxLength": 2000
          },
          "price": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000000
          },
          "tax_basis_points": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "is_available": {
            "type": "boolean"
          },
          "variants": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "object",
              "required": [
                "name",
                "price"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "maxLength": 100
                },
                "price": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10000000
                }
              }
            }
          },
          "modifier_group_ids": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "integer"
            }
          }
        }
      },
      "TokenInput": {
        "type": "object",
        "required": [
          "name",
          "abilities"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100
          },
          "abilities": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "menu:read",
                "menu:write",
                "orders:read",
                "orders:manage"
              ]
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "Tracking": {
        "type": "object",
        "properties": {
          "public_id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "total": {
            "type": "integer"
          },
          "currency": {
            "type": "string"
          },
          "history": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "to_status": {
                  "type": "string"
                },
                "created_at": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          }
        }
      },
      "Order": {
        "type": "object",
        "properties": {
          "public_id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "version": {
            "type": "integer"
          },
          "fulfillment": {
            "type": "string"
          },
          "customer_name": {
            "type": "string"
          },
          "customer_phone": {
            "type": "string"
          },
          "delivery_address": {
            "type": "string",
            "nullable": true
          },
          "notes": {
            "type": "string",
            "nullable": true
          },
          "subtotal": {
            "type": "integer"
          },
          "delivery_fee": {
            "type": "integer"
          },
          "total": {
            "type": "integer"
          },
          "currency": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "history": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "transitions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "MenuResponse": {
        "type": "object",
        "properties": {
          "location": {
            "type": "object"
          },
          "restaurant": {
            "type": "object"
          },
          "menus": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "fulfillment": {
            "type": "object"
          },
          "zones": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "hours": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      }
    }
  }
}
